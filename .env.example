# Copy this file to `.env` and fill in your Gemini key.
# Every demo in demos/ defaults to the Gemini provider (the only key
# needed to run all of them) -- see README.md for how to switch to
# OpenAI/Anthropic/Ollama instead.

GEMINI_API_KEY=

DEFAULT_PROVIDER=gemini
MODEL=gemini-2.5-flash

# Fallback only -- the demo scripts themselves share one coordinated
# RateLimiter via demos/_shared.py (see README.md's "Rate limiting"
# section), not this value. Only matters if you add an Agent()/AI() call
# somewhere that bypasses demos/_shared.py's make_agent()/make_ai().
RATE_LIMIT_RPM=12
RATE_LIMIT_MAX_WAIT_SECONDS=120

# --- Other providers (optional -- only needed if you switch a demo to
# use them instead of Gemini) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
